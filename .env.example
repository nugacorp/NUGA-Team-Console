# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_APP_MODE: Target operating environment ('demo' | 'staging' | 'production').
# Default is 'demo' if unset. Production cannot be activated from browser storage or client UI.
VITE_APP_MODE=demo

# VITE_NUGA_API_URL: Canonical base URL for backend services in staging and production.
# In DEMO mode, this URL is completely ignored and no external network calls are made.
VITE_NUGA_API_URL=/api

# Server-only staging configuration. Never prefix these values with VITE_.
# Generate NUGA_SESSION_SECRET directly on the deployment host; never commit its value.
NUGA_SERVER_MODE=staging
NUGA_SERVER_HOST=127.0.0.1
NUGA_SERVER_PORT=8787
NUGA_PUBLIC_ORIGIN=http://127.0.0.1:3000
NUGA_SESSION_SECRET=
NUGA_OWNER_USERNAME=ramiro
NUGA_OWNER_PASSWORD_HASH=
NUGA_HERMES_READ_ONLY_ENABLED=false
NUGA_HERMES_BINARY=/home/ramiro/.local/bin/hermes
NUGA_HERMES_BOARDS=default,nuga-team-lab,wisp-lab
NUGA_SUPABASE_ENABLED=false
NUGA_SUPABASE_URL=
NUGA_SUPABASE_SCHEMA=nuga_console
# Server-only sb_secret_ key. Never use VITE_, commit a value, or send it to the browser.
NUGA_SUPABASE_SECRET_KEY=
